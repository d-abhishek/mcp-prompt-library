# MCP Prompt Library Configuration

# =============================================================================
# Local Testing Mode
# =============================================================================
# Set to "true" to disable authentication and authorization (for local development)
# Set to "false" for production deployment with full Cognito authentication
# 
# When LOCAL_TESTING=true:
#   - No AWS Cognito authentication required
#   - All tools and prompts are accessible without group membership checks
#   - Ideal for local development and testing
#
# When LOCAL_TESTING=false:
#   - Full AWS Cognito authentication enabled
#   - Group-based authorization enforced
#   - Required for production deployments
#
LOCAL_TESTING=false

# =============================================================================
# AWS Cognito Configuration
# =============================================================================
# Required when LOCAL_TESTING=false
# Obtain these values from your AWS Cognito User Pool settings

# AWS Cognito User Pool ID (e.g., eu-west-1_XXXXXXXXX)
USER_POOL_ID=your-user-pool-id

# AWS Region where your Cognito User Pool is hosted
AWS_REGION=us-east-1

# App Client ID from your Cognito User Pool
CLIENT_ID=your-client-id

# App Client Secret from your Cognito User Pool
CLIENT_SECRET=your-client-secret

# Base URL for your application (must match the Callback URL in Cognito settings)
BASE_URL=http://localhost:8000
